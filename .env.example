# Gemini AI API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"

# Resend Transactional Email Configuration
# 1. RESEND_API_KEY: Create this in https://resend.com/api-keys (starts with re_)
RESEND_API_KEY="re_xxxxxxxxx"

# 2. RESEND_FROM_EMAIL: (Optional)
# If you don't have a verified custom domain, leave unset or use "Portfolio <onboarding@resend.dev>".
# Note: Free Resend test domain can only deliver emails to your registered Resend account email.
# Once you add and verify a custom domain in Resend, change this to: "Hari <contact@yourdomain.com>"
RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# 3. NOTIFICATION_EMAIL: (Optional, defaults to harinarzary22@gmail.com)
NOTIFICATION_EMAIL="harinarzary22@gmail.com"
